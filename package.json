{
  "name": "music-league-voting-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Music League round parser + draft vote allocator.",
  "scripts": {
    "ml": "node scripts/ml.mjs",
    "parse": "node scripts/parse-round.mjs",
    "render-fit": "node scripts/render-fit-html.mjs",
    "render-final": "node scripts/render-final-html.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "npm run lint:js && npm run lint:md",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2",
    "fix": "npm run fix:js && npm run fix:md",
    "fix:js": "eslint . --fix",
    "fix:md": "markdownlint-cli2 --fix"
  },
  "dependencies": {
    "linkedom": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "markdownlint-cli2": "^0.22.1"
  }
}
